---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found — Elident" description="This page does not exist. Return to the Elident home page or browse the shop." page="home">
<section class="wrap notfound" aria-labelledby="nf-title" style="padding-block: clamp(120px, 18cqi, 220px)">
  <p class="eyebrow">Error 404</p>
  <h1 id="nf-title" class="h1">This page is <em class="serif">off the bench.</em></h1>
  <p class="lead" style="margin-top: 24px">The link may be old or mistyped. The articulators are still where you left them.</p>
  <div class="btn-row" style="margin-top: 32px">
    <a class="btn btn-primary" href="/">Back to home<Arrow /></a>
    <a class="btn btn-secondary" href="/shop">Browse the shop</a>
  </div>
</section>
</Base>
