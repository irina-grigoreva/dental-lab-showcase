---
import Arrow from './Arrow.astro';
import { LOGO_DARK, LOGO_LIGHT } from '../data/content';

interface Props { page: string; }
const { page } = Astro.props;

const navItems = [
  { label: 'How It Works', href: '/#how-it-works', current: false },
  { label: 'Shop', href: '/shop', current: page === 'shop' || page === 'product' },
  { label: 'Lab Notes', href: '/notes', current: page === 'notes' || page === 'note' },
  { label: 'About & Contact', href: '/about', current: page === 'about' },
];
---
<header class="hdr is-dark" data-hdr>
  <div class="wrap hdr-in">
    <a class="logo" href="/" aria-label="Elident Articulator — home"><img class="logo-light" src={LOGO_LIGHT} alt="" width="143" height="36" style="width: 143px; height: 36px"><img class="logo-dark" src={LOGO_DARK} alt="" width="146" height="36" style="width: 146px; height: 36px"></a>
    <nav class="nav" aria-label="Main">
      {navItems.map((n) => (
        <a class:list={['nav-link', n.current && 'is-current']} href={n.href} aria-current={n.current ? 'page' : 'false'}>{n.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-sm hdr-cta" href="/product/kit">View Sample Kit</a>
    <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="el-menu" aria-label="Open menu" data-menu-btn>
      <svg data-icon-open width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
      <svg data-icon-close style="display: none" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
    </button>
  </div>
  <nav class="sheet" id="el-menu" aria-label="Mobile" hidden data-sheet>
    {navItems.map((n, i) => (
      <a class:list={['sheet-link', n.current && 'is-current']} href={n.href} aria-current={n.current ? 'page' : 'false'} data-first={i === 0 ? '' : undefined}>{n.label}<Arrow size={18} /></a>
    ))}
    <a class="btn btn-primary" href="/product/kit">View Sample Kit</a>
  </nav>
</header>
